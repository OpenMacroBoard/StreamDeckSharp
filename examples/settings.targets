<Project>
    <PropertyGroup>
        <!-- Use 'local' or 'nuget' -->
        <ReferenceType>nuget</ReferenceType>

        <!--
            The examples still use ImageSharp for drawing, directly and through the published
            packages. Its known vulnerabilities are reported as warnings here, not as errors,
            so they stay visible without breaking the build. The libraries do not use ImageSharp.
        -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>
</Project>