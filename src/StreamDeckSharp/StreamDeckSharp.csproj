<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>default</LangVersion>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <!-- OMB0001 marks the public types of the Internals namespaces, which this project may use -->
    <NoWarn>$(NoWarn);OMB0001</NoWarn>
  </PropertyGroup>

  <!-- nuget stuff -->
  <PropertyGroup>
    <Title>StreamDeckSharp</Title>
    <VersionPrefix>11.0.0</VersionPrefix>
    <Description>A simple .NET wrapper for StreamDeck (using OpenMacroBoard.SDK)</Description>
    <RepositoryUrl>https://github.com/OpenMacroBoard/StreamDeckSharp</RepositoryUrl>
  </PropertyGroup>

  <Import Project="..\..\package-defaults.targets" />
  <Import Project="..\..\analyzers.targets" />

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <ProjectReference Include="..\OpenMacroBoard.SDK\OpenMacroBoard.SDK.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
