<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>default</LangVersion>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- nuget stuff -->
  <PropertyGroup>
    <VersionPrefix>11.0.0</VersionPrefix>
    <Title>OpenMacroBoard.SDK.KeyBitmap.SkiaSharp</Title>
    <Description>KeyBitmap factory extension methods for SkiaSharp: draw key images with text and shapes on Windows, Linux and macOS.</Description>
    <RepositoryUrl>https://github.com/OpenMacroBoard/StreamDeckSharp</RepositoryUrl>
  </PropertyGroup>

  <Import Project="..\..\package-defaults.targets" />
  <Import Project="..\..\analyzers.targets" />

  <!-- This package is new, there is no released version to compare its API with. -->
  <PropertyGroup>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenMacroBoard.SDK\OpenMacroBoard.SDK.csproj" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
